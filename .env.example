DATABASE_URL=postgresql://folio:folio@127.0.0.1:5432/folio
DATABASE_SSL=disable
# DATABASE_CA_CERT_PATH=/run/secrets/postgres-ca.pem

# Managed OIDC. Redirect URI and issuer must use HTTPS.
# Generate the signing key with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# OIDC_ISSUER_URL=https://identity.example.com/
# OIDC_CLIENT_ID=folio
# OIDC_CLIENT_SECRET=replace-with-provider-secret
# OIDC_REDIRECT_URI=https://folio.example.com/api/auth/oidc/callback
# OIDC_STATE_SIGNING_KEY=replace-with-base64url-32-byte-secret
OIDC_SCOPES=openid profile email

# Temporary legacy reader settings retained during the migration phases.
DATABASE_PATH=.local-data/workspace.sqlite
WORKSPACE_ROOTS=
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=60
