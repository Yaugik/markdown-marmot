NODE_ENV=production
FOLIO_PUBLIC_URL=https://folio.example.com

DATABASE_URL=postgresql://folio_app:change-me@postgres.example.com:5432/folio
DATABASE_SSL=require
DATABASE_CA_CERT_PATH=/run/secrets/postgres-ca.pem

OIDC_ISSUER_URL=https://identity.example.com
OIDC_CLIENT_ID=folio
OIDC_CLIENT_SECRET=replace-with-secret-reference-in-deployment
OIDC_REDIRECT_URI=https://folio.example.com/api/auth/oidc/callback
OIDC_STATE_SIGNING_KEY=replace-with-at-least-43-random-characters
OIDC_SCOPES=openid profile email
WORKSPACE_INVITATION_SIGNING_KEY=replace-with-a-different-43-character-random-key

OBJECT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=folio-production
S3_ACCESS_KEY_ID=replace-through-secret-manager
S3_SECRET_ACCESS_KEY=replace-through-secret-manager
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=folio
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=replace-with-kms-key-id

GITHUB_APP_ID=123456
GITHUB_APP_SLUG=folio-example
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=replace-through-secret-manager
GITHUB_INSTALL_STATE_SIGNING_KEY=replace-with-at-least-43-random-characters
GITHUB_APP_CALLBACK_URL=https://folio.example.com/api/v1/github/installations/callback
GITHUB_CREDENTIAL_KEY_REF=secret-manager:github-app/private-key
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
GITHUB_HTTP_TIMEOUT_MS=30000
GITHUB_MAX_SNAPSHOT_FILES=10000
GITHUB_MAX_SNAPSHOT_BYTES=104857600

METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
OPERATIONS_ENVIRONMENT=production
BACKUP_RETENTION_DAYS=30
RESTORE_DRILL_MAX_AGE_DAYS=90

LEGACY_IMPORT_ENABLED=false
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=60
